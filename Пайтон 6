#Список предметів
SUBJECTS = ["Вища математика", "Дискретна математика", "Програмування"]

def add_student(full_name, group, course, subjects_grades): #Додавання нового студента
    if full_name in students: #Перевіряємо, чи студент уже є в базі
        print(f"Студент {full_name} вже є в базі!")
        return
    #Додаємо нового студента до словника
    students[full_name] = {
        'Група': group,
        'Курс': course,
        'Предмети та оцінки за семестр': subjects_grades
    }
    print(f"Студент {full_name} успішно доданий!")

#Пушкар Юлія Видалення студента і виведення всього словника

def delete_student(full_name): #Видалення студента за ПІБ
    if full_name in students: #Якщо ПІБ є в словнику — видаляємо запис
        del students[full_name]
        print(f"Студент {full_name} видалений!")
    else:
        print(f"Студента {full_name} не знайдено.")

def display_all_students(): #Виведення всього словника
    print("\nСПИСОК ВСІХ СТУДЕНТІВ")
    #Проходимо по кожному студенту та виводимо його дані
    for i, (name, info) in enumerate(students.items(), 1):
        print(f"\n{i}. {name}")
        print(f"   Група: {info['Група']}")
        print(f"   Курс: {info['Курс']}")
        for subj, grade in info['Предмети та оцінки за семестр'].items():
            print(f"     {subj}: {grade}")

#Ганжара Богдан функція пошуку студента за ПІБ, функція редагування інформації

def find_student(full_name):
    #Пошук студента за ПІБ
    if full_name in students:
        info = students[full_name]
        print(f"\nЗнайдено студента: {full_name}")
        print(f"Група: {info['Група']}, Курс: {info['Курс']}")
        #Виводимо усі оцінки
        for s, g in info['Предмети та оцінки за семестр'].items():
            print(f"   {s}: {g}")
    else:
        print("Студента не знайдено.")

def edit_student_info(full_name, field, new_value): #Функція редагування даних певного студента
    #Якщо студента немає — виходимо
    if full_name not in students:
        print("Студента не знайдено.")
        return

    student = students[full_name]
    #Якщо змінюється поле "Група" або "Курс
    if field == "Група":
        student["Група"] = new_value
        print("Групу змінено успішно.")

    elif field == "Курс":
        try:
            new_course = int(new_value)
            if new_course < 1:
                print("Курс має бути більше 0!")
                return
            student["Курс"] = new_course
            print("Курс змінено успішно.")
        except ValueError:
            print("Курс повинен бути числом!")
    #Якщо змінюється оцінка з предмету
    elif field in student["Предмети та оцінки за семестр"]:
        #Редагування оцінки з певного предмету
        try:
            grade = int(new_value)
            if 0 <= grade <= 100:
                student["Предмети та оцінки за семестр"][field] = grade
                print("Оцінку змінено успішно.")
            else:
                print("Оцінка повинна бути в межах 0–100!")
        except ValueError:
            print("Оцінка повинна бути числом!")

    else:
        print("Поле не знайдено.")

#Писана Оля функція сортування студентів за середнім балом
def calculate_average(grades): #Функція обчислення середнього бала
    return sum(grades.values()) / len(grades) if grades else 0 #Якщо немає оцінок — 0

def display_sorted_by_average(): # Виведення студентів за середнім балом
    print("\nСТУДЕНТИ ЗА СЕРЕДНІМ БАЛОМ:")
    #Сортування студентів за середнім балом
    sorted_students = sorted(
        students.items(),
        key=lambda x: calculate_average(x[1]["Предмети та оцінки за семестр"]),
        reverse=True
    )
    #Виводимо результат сортування
    for i, (name, info) in enumerate(sorted_students, 1):
        avg = calculate_average(info["Предмети та оцінки за семестр"])
        print(f"{i}. {name} — Середній бал: {avg:.2f}")

#Лозовська Роксана фільтрації за курсом/групою

def filter_by_course(course): #Фільтрація за курсом
    print(f"\nСТУДЕНТИ КУРСУ {course}:")
    found = False
    #Виводимо всіх студентів, які навчаються на заданому курсі
    for name, info in students.items():
        if info["Курс"] == course:
            found = True
            print(f" - {name} ({info['Група']})")
    if not found:
        print("Студентів не знайдено.")

def filter_by_group(group): #Фільтрація за групою
    print(f"\nСТУДЕНТИ ГРУПИ {group}:")
    found = False
    #Виводимо всіх студентів із заданої групи
    for name, info in students.items():
        if info["Група"] == group:
            found = True
            print(f" - {name} (курс {info['Курс']})")
    if not found:
        print("Студентів не знайдено.")

#Головна функція(Ніколаєнко Дмитро)
def main_menu():
    #Безкінечний цикл роботи меню поки користувач не обере вихід
    while True:
        print("\n--- ГОЛОВНЕ МЕНЮ ---")
        print("1. Переглянути всіх студентів")
        print("2. Додати нового студента")
        print("3. Видалити студента")
        print("4. Знайти студента")
        print("5. Редагувати дані студента")
        print("6. Сортувати за середнім балом")
        print("7. Фільтрувати за курсом")
        print("8. Фільтрувати за групою")
        print("0. Вихід")

        choice = input("Ваш вибір: ").strip()

        if choice == "1":
            display_all_students() #Виклик функції перегляду всіх студентів

        elif choice == "2":
            #Додавання нового студента
            name = input("Введіть ПІБ: ")
            group = input("Введіть групу: ")
            try:
                course = int(input("Введіть курс: "))
            except ValueError:
                print("Курс має бути числом!")
                continue
            subjects = {} # Словник для оцінок
            for subj in SUBJECTS:
                try:
                    grade = int(input(f"{subj}: "))
                    if 0 <= grade <= 100:
                        subjects[subj] = grade
                    else:
                        print("Оцінка поза межами 0–100! Збережено 0.")
                        subjects[subj] = 0
                except ValueError:
                    print("Некоректне значення, збережено 0.")
                    subjects[subj] = 0
            add_student(name, group, course, subjects)  # Виклик функції додавання

        elif choice == "3": #Видалення студента за ПІБ
            name = input("Введіть ПІБ студента: ")
            delete_student(name)

        elif choice == "4": #Пошук студента за ПІБ
            name = input("Введіть ПІБ студента: ")
            find_student(name)

        elif choice == "5": #Редагування даних студента
            name = input("Введіть ПІБ студента: ")
            field = input("Введіть поле (Група/Курс/назва предмету): ")
            new_value = input("Введіть нове значення: ")
            edit_student_info(name, field, new_value)

        elif choice == "6": #Сортування за середнім балом
            display_sorted_by_average()

        elif choice == "7": #Фільтрація студентів за курсом
            try:
                course = int(input("Введіть курс: "))
                filter_by_course(course)
            except ValueError:
                print("Курс має бути числом!")

        elif choice == "8": #Фільтрація студентів за групою
            group = input("Введіть групу: ")
            filter_by_group(group)

        elif choice == "0": #Завершення програми
            print("Роботу завершено.")
            break
        else:
            print("Невірний вибір!") #Перевірка на некоректне введення

#Запуск
if __name__ == "__main__":
    main_menu()
