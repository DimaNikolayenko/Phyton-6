#Список предметів
SUBJECTS = ["Вища математика", "Дискретна математика", "Програмування"]

def add_student(full_name, group, course, subjects_grades): #Додавання нового студента
    if full_name in students: #Перевіряємо, чи студент уже є в базі
        print(f"Студент {full_name} вже є в базі!")
        return
    #Додаємо нового студента до словника
    students[full_name] = {
        'Група': group,
        'Курс': course,
        'Предмети та оцінки за семестр': subjects_grades
    }
    print(f"Студент {full_name} успішно доданий!")

#Пушкар Юлія Видалення студента і виведення всього словника

def find_student(full_name):
    #Пошук студента за ПІБ
    if full_name in students:
        info = students[full_name]
        print(f"\nЗнайдено студента: {full_name}")
        print(f"Група: {info['Група']}, Курс: {info['Курс']}")
        #Виводимо усі оцінки
        for s, g in info['Предмети та оцінки за семестр'].items():
            print(f"   {s}: {g}")
    else:
        print("Студента не знайдено.")

def edit_student_info(full_name, field, new_value): #Функція редагування даних певного студента
    #Якщо студента немає — виходимо
    if full_name not in students:
        print("Студента не знайдено.")
        return

    student = students[full_name]
    #Якщо змінюється поле "Група" або "Курс
    if field == "Група":
        student["Група"] = new_value
        print("Групу змінено успішно.")

    elif field == "Курс":
        try:
            new_course = int(new_value)
            if new_course < 1:
                print("Курс має бути більше 0!")
                return
            student["Курс"] = new_course
            print("Курс змінено успішно.")
        except ValueError:
            print("Курс повинен бути числом!")
    #Якщо змінюється оцінка з предмету
    elif field in student["Предмети та оцінки за семестр"]:
        #Редагування оцінки з певного предмету
        try:
            grade = int(new_value)
            if 0 <= grade <= 100:
                student["Предмети та оцінки за семестр"][field] = grade
                print("Оцінку змінено успішно.")
            else:
                print("Оцінка повинна бути в межах 0–100!")
        except ValueError:
            print("Оцінка повинна бути числом!")

    else:
        print("Поле не знайдено.")

